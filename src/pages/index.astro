---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProductSplit from '../components/ProductSplit.astro';
import Technology from '../components/Technology.astro';
import Performance from '../components/Performance.astro';
import Showcase from '../components/Showcase.astro';
import Comparison from '../components/Comparison.astro';
import Business from '../components/Business.astro';
import Founder from '../components/Founder.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import { t } from '../data/i18n';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />

    <section class="section--tight trust hairline-top">
      <div class="container">
        <p class="trust__label" data-reveal data-i18n="trust.label">{t('trust.label')}</p>
        <div class="trust__names" data-reveal>
          <span>Mixed In Key</span>
          <span>Rekordbox</span>
        </div>
        <p class="trust__disc" data-reveal data-i18n="trust.disclaimer">{t('trust.disclaimer')}</p>
      </div>
    </section>

    <ProductSplit />
    <Technology />
    <Performance />
    <Showcase />
    <Comparison />
    <Business />
    <Founder />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <ContactModal />
</Base>

<style>
  .trust__label { text-align: center; font-size: 0.82rem; color: var(--text-3); letter-spacing: 0.02em; }
  .trust__names {
    margin-top: 20px;
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: clamp(20px, 5vw, 54px);
  }
  .trust__names span {
    font-size: clamp(1.05rem, 2.4vw, 1.5rem);
    font-weight: 600; letter-spacing: -0.02em;
    color: var(--text-2);
    opacity: 0.55;
    transition: opacity 0.2s ease, color 0.2s ease;
    filter: grayscale(1);
  }
  .trust__names span:hover { opacity: 1; color: var(--text); }
  .trust__disc { margin-top: 22px; text-align: center; font-size: 0.74rem; color: var(--text-3); max-width: 70ch; margin-inline: auto; line-height: 1.5; }
</style>
