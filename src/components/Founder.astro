---
import { Image } from 'astro:assets';
import { t } from '../data/i18n';
import { founder } from '../data/site';
import founderPhoto from '../assets/founder.jpg';

const links = [
  ['founder.link.email', `mailto:${founder.email}`, 'mail'],
  ['founder.link.telegram', founder.telegramUrl, 'tg'],
  ['founder.link.whatsapp', founder.whatsappUrl, 'wa'],
  ['founder.link.linkedin', founder.linkedin, 'in'],
  ['founder.link.github', founder.github, 'gh'],
];

const icons: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  tg: '<path d="M21 4 3 11l5 2 2 6 3-4 5 4 3-15Z"/>',
  wa: '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M8.5 8.5c0 4 3 7 7 7"/>',
  in: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4"/>',
  gh: '<path d="M9 19c-4 1.2-4-2-6-2m12 4v-3.2a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.3 3.3 5.3 3.6 5.3 3.6a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 10c0 4.6 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21"/>',
};
---

<section class="section hairline-top" id="founder">
  <div class="container">
    <div class="founder">
      <div class="founder__aside" data-reveal>
        <span class="eyebrow" data-i18n="founder.eyebrow">{t('founder.eyebrow')}</span>
        <div class="founder__avatar">
          <Image src={founderPhoto} alt={founder.name} widths={[240, 380, 480]} sizes="200px" loading="lazy" />
        </div>
      </div>
      <div class="founder__main" data-reveal style="--d:.06s">
        <h2 class="founder__name" data-i18n="founder.name">{t('founder.name')}</h2>
        <p class="founder__roles" data-i18n="founder.roles">{t('founder.roles')}</p>
        <p class="founder__bio" data-i18n="founder.bio">{t('founder.bio')}</p>
        <div class="founder__links">
          {links.map(([label, href, icon]) => (
            <a class="founder__link" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} />
              <span data-i18n={label}>{t(label)}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .founder { display: grid; grid-template-columns: 1fr; gap: 34px; }
  .founder__avatar {
    margin-top: 20px;
    width: 100%; max-width: 190px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow: 0 24px 50px -20px rgba(0,0,0,0.75), 0 0 0 6px rgba(49, 180, 101,0.10), inset 0 1px 0 rgba(255,255,255,0.08);
    position: relative;
  }
  .founder__avatar::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    background: linear-gradient(180deg, transparent 62%, rgba(11,12,15,0.35));
    pointer-events: none;
  }
  .founder__avatar :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center top;
    display: block;
    transform: scale(1.72);
    transform-origin: center 38%;
  }
  .founder__name { font-size: clamp(1.7rem, 3vw, 2.3rem); letter-spacing: -0.03em; }
  .founder__roles { margin-top: 10px; color: var(--accent-muted); font-size: 0.95rem; font-weight: 500; }
  .founder__bio { margin-top: 20px; color: var(--text-2); font-size: 1.02rem; line-height: 1.65; max-width: 68ch; }
  .founder__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .founder__link {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 15px; border-radius: var(--radius-pill);
    border: 1px solid var(--border); background: rgba(255,255,255,0.03);
    font-size: 0.88rem; font-weight: 500; color: var(--text-2);
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .founder__link:hover { color: #fff; border-color: rgba(49, 180, 101,0.5); background: rgba(49, 180, 101,0.12); transform: translateY(-1px); }
  .founder__link svg { color: var(--accent-bright); }

  @media (min-width: 820px) { .founder { grid-template-columns: 220px 1fr; gap: 48px; } }
</style>
