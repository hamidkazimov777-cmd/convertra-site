---
import { t } from '../data/i18n';
import { inquiries } from '../data/site';

const products = [
  {
    tag: 'split.app.tag', title: 'split.app.title', body: 'split.app.body', cta: 'split.app.cta',
    href: '#product', inquiry: 'app', accent: 'app',
    icon: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M7 9h4M7 12h7"/>',
  },
  {
    tag: 'split.core.tag', title: 'split.core.title', body: 'split.core.body', cta: 'split.core.cta',
    href: inquiries.license, inquiry: 'license', accent: 'core',
    icon: '<path d="M12 2a4 4 0 0 1 4 4v1a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4Z"/><path d="M5 20a7 7 0 0 1 14 0"/><path d="M12 11v3"/>',
  },
];
---

<section class="section hairline-top" id="platform">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow" data-i18n="split.eyebrow">{t('split.eyebrow')}</span>
      <h2 class="h-section" data-i18n="split.title">{t('split.title')}</h2>
      <p class="lead" data-i18n="split.subtitle">{t('split.subtitle')}</p>
    </div>

    <div class="split">
      {products.map((p, i) => (
        <article class={`card split__card split__card--${p.accent}`} data-reveal style={`--d:${i * 0.07}s`}>
          <div class="split__head">
            <span class="split__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <span class="chip split__tag" data-i18n={p.tag}>{t(p.tag)}</span>
          </div>
          <h3 class="split__title" data-i18n={p.title}>{t(p.title)}</h3>
          <p class="split__body" data-i18n={p.body}>{t(p.body)}</p>
          <a class="btn btn-primary split__cta js-cta" data-inquiry={p.inquiry} href={p.href}>
            <span data-i18n={p.cta}>{t(p.cta)}</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .split__card {
    display: flex; flex-direction: column; padding: 30px;
    transition-delay: var(--d, 0s);
  }
  .split__card--core {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(103,108,244,0.16), transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.012));
    border-color: rgba(103,108,244,0.3);
  }
  .split__card--app {
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(239,168,49,0.12), transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.012));
    border-color: rgba(239,168,49,0.24);
  }
  .split__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .split__icon {
    width: 50px; height: 50px; display: grid; place-items: center;
    border-radius: 13px; color: var(--accent-bright);
    background: rgba(103,108,244,0.12); border: 1px solid rgba(103,108,244,0.28);
  }
  .split__card--app .split__icon { color: var(--energy-bright); background: rgba(239,168,49,0.12); border-color: rgba(239,168,49,0.3); }
  .split__tag { font-size: 0.76rem; }
  .split__title { font-size: 1.45rem; letter-spacing: -0.025em; }
  .split__body { margin-top: 12px; color: var(--text-2); font-size: 0.97rem; line-height: 1.6; flex: 1; }
  .split__cta { margin-top: 24px; align-self: flex-start; }
  .split__card--app .split__cta {
    background: linear-gradient(135deg, var(--energy-bright), var(--energy));
    color: #1a1205;
    box-shadow: 0 8px 26px -8px rgba(239,168,49,0.6), inset 0 1px 0 rgba(255,255,255,0.35);
  }

  @media (min-width: 800px) { .split { grid-template-columns: 1fr 1fr; } }
</style>
