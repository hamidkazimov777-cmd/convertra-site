---
import { t } from '../data/i18n';
import { founder } from '../data/site';
const year = new Date().getFullYear();
const nav = [
  ['#technology', 'footer.nav.tech'],
  ['#performance', 'footer.nav.perf'],
  ['#opportunities', 'footer.nav.biz'],
  ['#contact', 'footer.nav.contact'],
];
---

<footer class="footer hairline-top">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="brand" href="#top" aria-label="Convertra">
        <span class="brand__mark" aria-hidden="true">
          <img src="/favicon.svg" alt="" width="30" height="30" />
        </span>
        <span class="brand__word">Convertra</span>
      </a>
      <p class="footer__tag" data-i18n="footer.tagline">{t('footer.tagline')}</p>
    </div>
    <nav class="footer__nav" aria-label="Footer">
      {nav.map(([href, key]) => (<a href={href} data-i18n={key}>{t(key)}</a>))}
    </nav>
  </div>
  <div class="container footer__bottom">
    <p class="footer__legal">© {year} Convertra · {founder.name}. <span data-i18n="footer.rights">{t('footer.rights')}</span></p>
    <p class="footer__disc" data-i18n="footer.independent">{t('footer.independent')}</p>
  </div>
</footer>

<style>
  .footer { padding-top: clamp(48px, 6vw, 72px); padding-bottom: 40px; background: var(--bg-base); }
  .footer__inner { display: grid; grid-template-columns: 1fr; gap: 30px; padding-bottom: 34px; }
  .footer .brand { display: inline-flex; align-items: center; gap: 10px; }
  .footer .brand__mark { width: 30px; height: 30px; border-radius: 7px; overflow: hidden; background: transparent; }
  .footer .brand__mark img { width: 100%; height: 100%; display: block; }
  .footer .brand__word { font-weight: 600; font-size: 1rem; }
  .footer__tag { margin-top: 14px; color: var(--text-2); font-size: 0.9rem; max-width: 42ch; line-height: 1.55; }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 20px; align-content: start; }
  .footer__nav a { color: var(--text-2); font-size: 0.9rem; }
  .footer__nav a:hover { color: #fff; }
  .footer__bottom { padding-top: 26px; border-top: 1px solid var(--border-subtle); }
  .footer__legal { color: var(--text-2); font-size: 0.84rem; }
  .footer__disc { margin-top: 8px; color: var(--text-3); font-size: 0.76rem; line-height: 1.5; max-width: 90ch; }
  @media (min-width: 720px) { .footer__inner { grid-template-columns: 1.4fr 1fr; } }
</style>
