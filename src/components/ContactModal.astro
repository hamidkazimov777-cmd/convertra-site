---
import { t } from '../data/i18n';
import { founder, inquiries } from '../data/site';

// Map an inquiry key -> its scoped mailto and the label shown as the modal chip.
const mailtoMap: Record<string, string> = {
  license: inquiries.license,
  acquisition: inquiries.acquisition,
  whitelabel: inquiries.whitelabel,
  partnership: inquiries.partnership,
  investment: inquiries.investment,
  app: inquiries.app,
  general: inquiries.general,
};
const labelKeyMap: Record<string, string> = {
  license: 'contact.cta.license.title',
  acquisition: 'contact.cta.buy.title',
  whitelabel: 'biz.wl.title',
  partnership: 'contact.cta.partner.title',
  investment: 'contact.cta.invest.title',
  app: 'split.app.title',
  general: 'modal.heading',
};

const channels = [
  ['founder.link.telegram', `@${founder.telegram}`, founder.telegramUrl, 'tg'],
  ['founder.link.whatsapp', founder.whatsapp, founder.whatsappUrl, 'wa'],
  ['founder.link.linkedin', 'hamid-kazimov', founder.linkedin, 'in'],
  ['founder.link.github', 'hamidkazimov777-cmd', founder.github, 'gh'],
];
const icons: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  tg: '<path d="M21 4 3 11l5 2 2 6 3-4 5 4 3-15Z"/>',
  wa: '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M8.5 8.5c0 4 3 7 7 7"/>',
  in: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4"/>',
  gh: '<path d="M9 19c-4 1.2-4-2-6-2m12 4v-3.2a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.3 3.3 5.3 3.6 5.3 3.6a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 10c0 4.6 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21"/>',
};
---

<div class="cm" data-modal hidden>
  <div class="cm__backdrop" data-modal-close></div>
  <div class="cm__dialog" role="dialog" aria-modal="true" aria-labelledby="cm-title">
    <button class="cm__close" type="button" data-modal-close data-i18n-attr="aria-label:a11y.close" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <span class="cm__chip" data-cm-chip data-i18n="modal.heading">{t('modal.heading')}</span>
    <h3 class="cm__title" id="cm-title" data-i18n="modal.heading">{t('modal.heading')}</h3>
    <p class="cm__sub" data-i18n="modal.sub">{t('modal.sub')}</p>

    <div class="cm__list">
      <a class="cm__row cm__row--primary" data-cm-email href={inquiries.general}>
        <span class="cm__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} />
        </span>
        <span class="cm__meta">
          <span class="cm__label" data-i18n="founder.link.email">{t('founder.link.email')}</span>
          <span class="cm__handle">{founder.email}</span>
        </span>
        <svg class="cm__arrow" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>

      {channels.map(([label, handle, href, icon]) => (
        <a class="cm__row" href={href} target="_blank" rel="noopener">
          <span class="cm__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} />
          </span>
          <span class="cm__meta">
            <span class="cm__label" data-i18n={label}>{t(label)}</span>
            <span class="cm__handle">{handle}</span>
          </span>
          <svg class="cm__arrow" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ mailtoMap, labelKeyMap }}>
  (() => {
    const modal = document.querySelector('[data-modal]');
    if (!modal) return;
    const dialog = modal.querySelector('.cm__dialog');
    const emailRow = modal.querySelector('[data-cm-email]');
    const chip = modal.querySelector('[data-cm-chip]');
    let lastFocus = null;

    const tt = (key) => {
      const el = document.getElementById('i18n-data');
      const D = el ? JSON.parse(el.textContent || '{}') : {};
      const loc = document.documentElement.lang || 'en';
      return (D[loc] && D[loc][key]) || (D.en && D.en[key]) || key;
    };

    function open(inquiry) {
      const key = inquiry && mailtoMap[inquiry] ? inquiry : 'general';
      if (emailRow) emailRow.setAttribute('href', mailtoMap[key]);
      if (chip) {
        const lk = labelKeyMap[key];
        chip.setAttribute('data-i18n', lk);
        chip.textContent = tt(lk);
      }
      lastFocus = document.activeElement;
      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      const first = modal.querySelector('.cm__row');
      first && first.focus();
    }
    function close() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      const done = () => { modal.hidden = true; dialog.removeEventListener('transitionend', done); };
      dialog.addEventListener('transitionend', done);
      setTimeout(() => { if (!modal.hidden && !modal.classList.contains('is-open')) modal.hidden = true; }, 320);
      lastFocus && lastFocus.focus && lastFocus.focus();
    }

    // Expose for other components (e.g. the hero's dynamic CTA).
    window.convertraOpenContact = open;

    // Open from any CTA marked with .js-cta (href stays as a no-JS fallback).
    document.querySelectorAll('.js-cta').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open(el.getAttribute('data-inquiry') || 'general');
      });
    });
    modal.querySelectorAll('[data-modal-close]').forEach((el) =>
      el.addEventListener('click', close)
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  })();
</script>

<style>
  .cm {
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-items: center;
    padding: 20px;
  }
  .cm[hidden] { display: none; }
  .cm__backdrop {
    position: absolute; inset: 0;
    background: rgba(6, 7, 10, 0.62);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    opacity: 0; transition: opacity 0.28s ease;
  }
  .cm.is-open .cm__backdrop { opacity: 1; }

  .cm__dialog {
    position: relative;
    width: min(440px, 100%);
    background: linear-gradient(180deg, #17181d, #101116);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 30px 26px 22px;
    box-shadow: 0 40px 90px -30px rgba(0,0,0,0.85), inset 0 1px 0 rgba(255,255,255,0.06);
    transform: translateY(14px) scale(0.94);
    opacity: 0;
    transition: transform 0.34s cubic-bezier(0.22, 1.2, 0.36, 1), opacity 0.26s ease;
  }
  .cm.is-open .cm__dialog { transform: none; opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .cm__dialog, .cm__backdrop { transition: none; }
  }

  .cm__close {
    position: absolute; top: 16px; right: 16px;
    width: 34px; height: 34px; display: grid; place-items: center;
    border-radius: 3px; border: 1px solid var(--border);
    background: rgba(255,255,255,0.04); color: var(--text-2);
    transition: background 0.18s ease, color 0.18s ease;
  }
  .cm__close:hover { background: rgba(255,255,255,0.09); color: #fff; }

  .cm__chip {
    display: inline-flex; align-items: center;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent-muted);
    padding: 5px 11px; border-radius: 3px;
    background: rgba(240, 160, 42,0.12); border: 1px solid rgba(240, 160, 42,0.3);
  }
  .cm__title { margin-top: 14px; font-size: 1.45rem; letter-spacing: -0.02em; }
  .cm__sub { margin-top: 8px; color: var(--text-2); font-size: 0.92rem; line-height: 1.5; }

  .cm__list { margin-top: 20px; display: flex; flex-direction: column; gap: 8px; }
  .cm__row {
    display: flex; align-items: center; gap: 13px;
    padding: 12px 14px; border-radius: 13px;
    border: 1px solid var(--border); background: rgba(255,255,255,0.02);
    transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
  }
  .cm__row:hover { border-color: rgba(240, 160, 42,0.45); background: rgba(240, 160, 42,0.09); transform: translateY(-1px); }
  .cm__row--primary {
    background: linear-gradient(180deg, rgba(240, 160, 42,0.16), rgba(240, 160, 42,0.06));
    border-color: rgba(240, 160, 42,0.4);
  }
  .cm__ic {
    width: 38px; height: 38px; flex: none;
    display: grid; place-items: center; border-radius: 10px;
    color: var(--accent-bright);
    background: rgba(240, 160, 42,0.14); border: 1px solid rgba(240, 160, 42,0.26);
  }
  .cm__meta { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1; }
  .cm__label { font-size: 0.9rem; font-weight: 600; color: #fff; }
  .cm__handle { font-size: 0.8rem; color: var(--text-3); font-family: var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cm__arrow { color: var(--text-3); flex: none; transition: color 0.16s ease, transform 0.16s ease; }
  .cm__row:hover .cm__arrow { color: var(--accent-bright); transform: translateX(2px); }
</style>
