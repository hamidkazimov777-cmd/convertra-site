---
import { t } from '../data/i18n';
import { inquiries } from '../data/site';

const items = [
  ['biz.acq.title', 'biz.acq.body', 'biz.acq.cta', inquiries.acquisition, 'feature', 'acquisition'],
  ['biz.lic.title', 'biz.lic.body', 'biz.lic.cta', inquiries.license, 'feature', 'license'],
  ['biz.wl.title', 'biz.wl.body', 'biz.wl.cta', inquiries.whitelabel, '', 'whitelabel'],
  ['biz.part.title', 'biz.part.body', 'biz.part.cta', inquiries.partnership, '', 'partnership'],
  ['biz.inv.title', 'biz.inv.body', 'biz.inv.cta', inquiries.investment, '', 'investment'],
];
---

<section class="section hairline-top" id="opportunities">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow" data-i18n="biz.eyebrow">{t('biz.eyebrow')}</span>
      <h2 class="h-section" data-i18n="biz.title">{t('biz.title')}</h2>
      <p class="lead" data-i18n="biz.subtitle">{t('biz.subtitle')}</p>
    </div>

    <div class="biz">
      {items.map(([title, body, cta, href, feat, inq], i) => (
        <article class={`card biz__card ${feat ? 'biz__card--feature' : ''}`} data-reveal style={`--d:${i * 0.05}s`}>
          <div class="biz__top">
            <h3 class="biz__title" data-i18n={title}>{t(title)}</h3>
            <span class="biz__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <p class="biz__body" data-i18n={body}>{t(body)}</p>
          <a class={`biz__cta js-cta ${feat ? 'btn btn-primary' : ''}`} data-inquiry={inq} href={href}>
            <span data-i18n={cta}>{t(cta)}</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .biz { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .biz__card { display: flex; flex-direction: column; transition-delay: var(--d, 0s); }
  .biz__card--feature {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(240, 160, 42,0.16), transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.012));
    border-color: rgba(240, 160, 42,0.32);
  }
  .biz__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .biz__title { font-size: 1.22rem; letter-spacing: -0.02em; }
  .biz__idx { font-family: var(--mono); font-size: 0.78rem; color: var(--text-3); }
  .biz__body { margin-top: 12px; color: var(--text-2); font-size: 0.94rem; line-height: 1.55; flex: 1; }
  .biz__cta {
    display: inline-flex; align-items: center; gap: 7px;
    margin-top: 22px; font-weight: 600; font-size: 0.9rem;
    color: var(--accent-bright); align-self: flex-start;
    transition: gap 0.2s ease, color 0.2s ease;
  }
  .biz__cta:not(.btn):hover { gap: 11px; color: var(--accent-hover); }
  .biz__cta.btn { color: #fff; }
  .biz__cta.btn:hover { gap: 11px; }

  @media (min-width: 640px) { .biz { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) {
    .biz { grid-template-columns: repeat(6, 1fr); }
    .biz__card { grid-column: span 2; }
    /* 5 cards over 6 cols: first two feature cards span 3 each on the top row */
    .biz__card--feature { grid-column: span 3; }
  }
</style>
